# Set the REAL public origin before production deployment. No trailing slash.
PUBLIC_SITE_URL=
# An actual booking URL, if available. Otherwise CTAs lead to the contact page.
PUBLIC_BOOKING_URL=
# Optional HTTPS endpoint accepting a JSON project brief; see README for its contract.
# Never put private keys or provider secrets in PUBLIC_ variables.
PUBLIC_LEAD_ENDPOINT=
# Add only verified contact information. Empty fields render an intentional pending state.
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_PHONE=
PUBLIC_WHATSAPP_URL=
PUBLIC_MESSENGER_URL=
