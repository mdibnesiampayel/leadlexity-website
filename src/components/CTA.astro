---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { callHref } from '../data/site';
---

<section class="cta-section section-padding" aria-labelledby="cta-title">
  <div class="container">
    <div class="cta-panel" data-reveal>
      <div class="cta-panel__content">
        <p class="eyebrow">
          <span class="eyebrow-mark"></span>LET’S MAKE YOUR NEXT MOVE COUNT
        </p>
        <h2 id="cta-title">Ready to turn attention into growth?</h2>
        <p class="cta-description">
          Let’s talk about your business, your goals, and where LeadLexity can make the biggest
          impact.
        </p>
        <div class="button-row">
          <Button href={callHref}>Book a Free Strategy Call</Button>
          <Button href="/contact" variant="text" icon="arrow-right">
            Contact LeadLexity
          </Button>
        </div>
      </div>
      <div class="cta-art" aria-hidden="true">
        <div class="cta-art__ring"></div>
        <div class="cta-art__ring cta-art__ring--second"></div>
        <Icon name="arrow-up-right" size={100} stroke={1} />
        <span>FORWARD, TOGETHER.</span>
      </div>
    </div>
  </div>
</section>
