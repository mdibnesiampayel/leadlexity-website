---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  centered?: boolean;
}
const { eyebrow, title, description, centered = false } = Astro.props;
---

<div class:list={['section-heading', { 'section-heading--centered': centered }]} data-reveal>
  <div class="section-heading__main">
    <p class="eyebrow">
      <span class="eyebrow-mark"></span>
      {eyebrow}
    </p>
    <h2>{title}</h2>
  </div>
  {description && (
    <div class="section-heading__aside">
      <p>{description}</p>
      <slot />
    </div>
  )}
</div>
