---
import SiteLayout from '../layouts/SiteLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import '../styles/pages.css';
---

<SiteLayout
  title="Page Not Found | LeadLexity"
  description="This page couldn’t be found. Explore LeadLexity’s services or return to the homepage."
  noindex
>
  <section class="not-found page-hero">
    <div class="container">
      <p class="eyebrow">
        <span class="eyebrow-mark"></span>404 / A DIFFERENT DIRECTION
      </p>
      <span class="not-found__icon">
        <Icon name="compass" size={48} stroke={1.2} />
      </span>
      <h1>
        Let’s get you
        <br />
        back on track.
      </h1>
      <p class="page-hero__description">
        This page may have moved, or the link may be incorrect. There’s still plenty to explore.
      </p>
      <div class="button-row">
        <Button href="/">Back to Home</Button>
        <Button href="/services" variant="secondary">
          Explore Our Services
        </Button>
      </div>
    </div>
  </section>
</SiteLayout>
