---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = site.url ? new URL(pathname, site.url).href : pathname;
const ogImage = site.url ? new URL('/og-image.png', site.url).href : '/og-image.png';
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  description: site.description,
  slogan: site.tagline,
  ...(site.url ? { url: site.url, logo: `${site.url}/brand/leadlexity-black.png` } : {}),
  ...(site.email ? { email: site.email } : {}),
  ...(site.phone ? { telephone: site.phone } : {}),
  ...([site.whatsapp, site.messenger].some(Boolean)
    ? { sameAs: [site.whatsapp, site.messenger].filter(Boolean) }
    : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LeadLexity" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="LeadLexity. Where Creativity Meets Conversion. A digital growth agency for service-based businesses."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#fbfcf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101813" media="(prefers-color-scheme: dark)" />
    <link
      rel="icon"
      type="image/png"
      href="/brand/leadlexity-black.png"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/png"
      href="/brand/leadlexity-white.png"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="preload"
      href="/fonts/manrope-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script is:inline>
      (() => {
        let preference = 'system';
        try {
          const saved = localStorage.getItem('leadlexity-theme');
          if (['light', 'dark', 'system'].includes(saved)) preference = saved;
        } catch {}
        const resolved =
          preference === 'system'
            ? matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light'
            : preference;
        document.documentElement.dataset.theme = resolved;
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.style.colorScheme = resolved;
      })();
    </script>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(organization).replace(/</g, '\\u003c')}
    ></script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <Navbar />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
